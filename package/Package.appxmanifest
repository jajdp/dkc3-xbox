<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <!-- CAMBIA LAS DOS PRIMERAS LINEAS POR LAS TUYAS antes de empaquetar.

       Publisher tiene que ser IDENTICO al sujeto de tu certificado de firma (docs/INSTALL.md
       seccion 4). Si no coinciden, la consola rechaza el paquete; package_uwp.py lo comprueba
       antes de empaquetar y te lo dice.

       Name es el nombre interno del paquete. Con el Publisher forma la FAMILIA, que es como la
       consola reconoce al juego y de la que cuelga su LocalState: ahi viven la configuracion y
       las partidas. Cambiarlo mas adelante crea otro juego a ojos de la consola, con su carpeta
       en blanco, y el viejo sigue instalado aparte. Eligelo una vez y dejalo.

       Version se queda en 0.1.0.0 SIEMPRE: la pone package_uwp.py al empaquetar, buscando ese
       texto exacto. Si la cambias aqui, el reemplazo no ocurre y no avisa. -->
  <Identity
    Name="CHANGE-ME-DKC3Recomp"
    Publisher="CN=CHANGE-ME"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <mp:PhoneIdentity PhoneProductId="12c47776-aad8-46b5-bb2e-daff6a921c3e" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Donkey Kong Country 3 Recomp Widescreen</DisplayName>
    <PublisherDisplayName>CHANGE-ME</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.VCLibs.140.00" MinVersion="14.0.33519.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="DKC3Recomp.exe"
      EntryPoint="DKC3Recomp.App">
      <uap:VisualElements
        DisplayName="Donkey Kong Country 3 Recomp Widescreen"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="UWP build of the DKC3Recomp static recompilation, for an Xbox Series in Developer Mode"
        BackgroundColor="transparent">
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
    <rescap:Capability Name="broadFileSystemAccess" />
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer"/>
    <Capability Name="privateNetworkClientServer"/>
    <uap:Capability Name="removableStorage"/>
  </Capabilities>
</Package>
